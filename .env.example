# =====================================================================
# RECORDATORIO: este archivo es solo una PLANTILLA.
#
# Para que el agente funcione:
#   1. Crea un archivo llamado .env en la raíz del proyecto, copiando este:
#        Linux/macOS:        cp .env.example .env
#        Windows PowerShell: Copy-Item .env.example .env
#   2. En el .env, escribe tu API key de Anthropic en ANTHROPIC_API_KEY
#      (se obtiene en https://platform.claude.com → Settings → API Keys).
#
# NO escribas tu API key aquí: .env.example sí se sube al repositorio.
# El archivo .env está en .gitignore y nunca se sube.
# =====================================================================

# Requerida para el agente real (no para los tests).
ANTHROPIC_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=4096
# KNOWLEDGE_BASE_DIR=data/knowledge_base
# SKILLS_DIR=skills
# CONVERSATION_SKILL=atencion_al_cliente
# CONVERSATIONS_DIR=conversations
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RETRIEVAL_TOP_K=4
# RETRIEVAL_THRESHOLD=0.25
# RETRIEVAL_CONTEXT_THRESHOLD=0.12
# RETRIEVAL_ALPHA=0.7
# MAX_TOOL_ITERATIONS=4


# Si se define, POST /chat exige el header X-API-Key con este valor (es para  exponerlo en internet).
# DEMO_API_KEY=
